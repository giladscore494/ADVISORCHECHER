# Copy to .env (never commit .env) or put the same keys in .streamlit/secrets.toml
KIMI_API_KEY=
SERPER_API_KEY=

# Optional
# LLM_PROVIDER=kimi            # kimi | glm | openai (default selection in the UI)
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k3
# KIMI_REASONING_EFFORT=max
# LLM_TIMEOUT=600
# MAX_AGENT_STEPS=25
# MAX_SEARCHES=30
# MAX_FETCHES=20

# Only needed when LLM_PROVIDER=glm
# GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# GLM_MODEL=glm-5.3

# Only needed for the OpenAI provider (Responses API)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_REASONING_EFFORT=high

# Durable research checkpoints. Default: local SQLite (.research_runs/runs.sqlite), which does NOT survive
# container replacement. Use PostgreSQL on Streamlit Community Cloud or other ephemeral hosts.
# RESEARCH_STORE_URL=postgresql://user:password@host:5432/dbname
# RESEARCH_RUN_MODE=background   # background | inline
# RESEARCH_LIST_RUNS=0           # 1 = list recent runs in the UI (private single-user deploys only)
